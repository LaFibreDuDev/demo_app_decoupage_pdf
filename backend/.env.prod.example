# Configuration production — copier en .env.prod et adapter
# Ce fichier ne doit PAS être versionné dans git (voir .gitignore)

# Taille maximale d'upload en Mo
# ⚠ Doit correspondre à client_max_body_size dans nginx/nginx.prod.conf
UPLOAD_MAX_SIZE_MB=10

# Répertoire de stockage temporaire des sessions (volume Docker)
TEMP_DIR=/tmp/pdf_splitter

# Durée de vie des sessions en heures
SESSION_TTL_HOURS=24

# Résolution des miniatures en DPI
THUMB_DPI=150

# Origines autorisées pour le CORS
# En prod, frontend et API partagent le même domaine (nginx) → CORS same-origin.
# Indiquer quand même le domaine de production pour sécurité.
ALLOWED_ORIGINS=https://votre-domaine.com
