# Configuration de l'application PDF Splitter
# Copier ce fichier en .env et ajuster les valeurs selon l'environnement

# Taille maximale d'upload en Mo
UPLOAD_MAX_SIZE_MB=10

# Répertoire de stockage temporaire des sessions
TEMP_DIR=/tmp/pdf_splitter

# Durée de vie des sessions en heures (nettoyage automatique)
SESSION_TTL_HOURS=24

# Résolution des miniatures en DPI (compromis qualité/vitesse)
THUMB_DPI=150

# Origines autorisées pour le CORS (séparées par des virgules)
# Dev local direct (npm run dev + uvicorn) :
ALLOWED_ORIGINS=http://localhost:5173
# Dev Docker (docker compose -f docker-compose.dev.yml up) :
# La valeur ci-dessous est injectée par docker-compose via `environment:`, pas besoin de la changer ici.
# ALLOWED_ORIGINS=http://frontend.localhost:8080
